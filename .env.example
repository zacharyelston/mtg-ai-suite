# MTG AI Suite Environment Variables
# Copy this file to .env and fill in your values

# ============================================
# Database
# ============================================
DATABASE_URL=postgres://postgres:your_password@localhost:5432/mtg_ai_suite
POSTGRES_PASSWORD=your_password

# ============================================
# Redis (optional, for caching)
# ============================================
REDIS_URL=redis://localhost:6379

# ============================================
# LLM Provider
# ============================================
LLM_PROVIDER=openai
LLM_API_KEY=sk-your-openai-api-key

# Alternative providers:
# LLM_PROVIDER=anthropic
# LLM_API_KEY=sk-ant-your-anthropic-key
# LLM_PROVIDER=ollama
# OLLAMA_BASE_URL=http://localhost:11434

# ============================================
# Server
# ============================================
PORT=8080
SECRET_KEY=generate-a-secure-random-string-here
RUST_LOG=info

# ============================================
# Scryfall API (no key required, but rate limited)
# ============================================
SCRYFALL_RATE_LIMIT_MS=100

# ============================================
# Development
# ============================================
# RUST_BACKTRACE=1
# RUST_LOG=debug
