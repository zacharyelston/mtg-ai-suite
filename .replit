modules = ["rust-stable", "nodejs-20", "python-3.11"]

[agent]
expertMode = true
integrations = ["github:1.0.0"]

[nix]
channel = "stable-25_05"

[env]
RUST_LOG = "info"
PORT = "8080"
[workflows]
runButton = "Project"

[[workflows.workflow]]
name = "Project"
mode = "parallel"
author = "agent"

[workflows.workflow.metadata]
outputType = "webview"

[[workflows.workflow.tasks]]
task = "shell.exec"
args = "mkdir -p data && cargo run --bin mtg-server"

[[workflows.workflow.tasks]]
task = "workflow.run"
args = "Backend"

[[workflows.workflow]]
name = "Backend"
author = "agent"

[[workflows.workflow.tasks]]
task = "shell.exec"
args = "cargo run --package mtg-server"
waitForPort = 5000

[workflows.workflow.metadata]
outputType = "webview"

[[ports]]
localPort = 5000
externalPort = 80

[deployment]
deploymentTarget = "autoscale"
run = ["./target/release/mtg-server"]
build = ["cargo", "build", "--package", "mtg-server", "--release"]

[userenv]

[userenv.shared]
PORT = "5000"
