modules = ["rust-stable", "nodejs-20"]

# Explicitly disable PostgreSQL database provisioning
[database]
enabled = false

[agent]
expertMode = true
integrations = ["github:1.0.0"]

[nix]
channel = "stable-24_05"

[env]
RUST_LOG = "info"
PORT = "8080"
DATABASE_URL = "sqlite:./data/dev.db"

[workflows]
runButton = "Project"

[[workflows.workflow]]
name = "Project"
mode = "parallel"
author = "agent"

[workflows.workflow.metadata]
outputType = "webview"

[[workflows.workflow.tasks]]
task = "shell.exec"
args = "mkdir -p data && cargo run --bin mtg-server"

[[workflows.workflow.tasks]]
task = "workflow.run"
args = "Frontend"

[[workflows.workflow]]
name = "Frontend"
author = "agent"

[[workflows.workflow.tasks]]
task = "shell.exec"
args = "cd frontend && npm run dev"
waitForPort = 5000

[workflows.workflow.metadata]
outputType = "webview"

[[ports]]
localPort = 5000
externalPort = 80

[[ports]]
localPort = 8080
externalPort = 80

[deployment]
deploymentTarget = "autoscale"
run = ["sh", "-c", "mkdir -p data && cargo run --release --bin mtg-server"]
build = ["cargo", "build", "--release"]
