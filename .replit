modules = ["rust-stable", "nodejs-20"]

[nix]
channel = "stable-24_05"

[env]
RUST_LOG = "info"
PORT = "8080"

[workflows]
runButton = "Project"

[[workflows.workflow]]
name = "Project"
mode = "parallel"
author = "agent"

[workflows.workflow.metadata]
outputType = "webview"

[[workflows.workflow.tasks]]
task = "shell.exec"
args = "cargo run --release --bin mtg-server"
waitForPort = 8080

[[workflows.workflow.tasks]]
task = "workflow.run"
args = "Frontend"

[[workflows.workflow]]
name = "Frontend"
author = "agent"

[[workflows.workflow.tasks]]
task = "shell.exec"
args = "cd frontend && npm run dev"
waitForPort = 5000

[workflows.workflow.metadata]
outputType = "webview"

[[ports]]
localPort = 5000
externalPort = 80

[[ports]]
localPort = 8080
externalPort = 8080

[deployment]
deploymentTarget = "autoscale"
run = ["bash", "-c", "cargo run --release --bin mtg-server & cd frontend && npm run start -- -p 5000"]
build = ["bash", "-c", "cargo build --release --bin mtg-server && cd frontend && npm install && npm run build"]
