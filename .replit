modules = ["rust-stable", "nodejs-20", "python-3.11"]

[agent]
expertMode = true
integrations = ["github:1.0.0"]

[nix]
channel = "stable-24_05"

[env]
RUST_LOG = "info"
PORT = "8080"
DATABASE_URL = "sqlite:./data/dev.db"

[workflows]
runButton = "Project"

[[workflows.workflow]]
name = "Frontend"
author = "agent"

[workflows.workflow.metadata]
outputType = "webview"

[[workflows.workflow.tasks]]
task = "shell.exec"
args = "cd frontend && npm run dev"
waitForPort = 5000

[[workflows.workflow]]
name = "Backend"
author = "agent"

[[workflows.workflow.tasks]]
task = "shell.exec"
args = "PORT=8000 ./target/debug/mtg-server"
waitForPort = 8000

[workflows.workflow.metadata]
outputType = "console"

[[ports]]
localPort = 5000
externalPort = 80

[[ports]]
localPort = 8000
externalPort = 8000

[[ports]]
localPort = 8080
externalPort = 80

[deployment]
deploymentTarget = "vm"
run = ["bash", "-c", "PORT=8000 ./target/release/mtg-server & cd frontend && npm run start"]
build = ["bash", "-c", "cargo build --release -p mtg-server && cd frontend && npm install && npm run build"]
